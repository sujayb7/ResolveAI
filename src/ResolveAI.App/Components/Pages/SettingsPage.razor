@page "/settings"
@inject AppService Service
@inject AccessCodeStore Codes
@using ResolveAI.App.Llm
@inject NavigationManager Nav

<PageTitle>ResolveAI</PageTitle>

<div class="page-enter max-w-2xl space-y-4">
    <h1 class="text-xl font-semibold">Settings &amp; demo data</h1>

    <Card Title="AI model and key" Icon="analysis">
        @* Current state, one line. *@
        <div class="@Ui.Cx("flex flex-wrap items-center gap-x-3 gap-y-1 rounded-md px-3 py-2 text-sm", _status.Mode == "live" ? "bg-emerald-50" : "bg-slate-50")" data-testid="llm-status">
            <span class="@Ui.Cx("inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-semibold", _status.Mode == "live" ? "bg-emerald-600 text-white" : "bg-slate-500 text-white")">
                <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-white"></span>
                @(_status.Mode == "live" ? "Live" : "Recorded")
            </span>
            @if (_status.Mode == "live")
            {
                <span class="font-medium text-slate-900">@LlmKeys.Label(_status.Provider) · <span class="font-mono">@(_status.Model ?? "default model")</span></span>
                <span class="ml-auto text-xs text-slate-500" title="Saved from: @_status.Source">key <span class="font-mono">@_status.KeyHint</span>@(_status.TestedAt is not null ? $" · tested {Ui.FormatTime(_status.TestedAt, true)}" : "")</span>
            }
            else
            {
                <span class="text-slate-600">No model is called. Investigations use recorded analysis.</span>
            }
        </div>
        @if (_status.Warning is not null)
        {
            <p class="mt-2 rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-900">@_status.Warning</p>
        }

        <form class="mt-4 space-y-4" @onsubmit="TestAndSave" @onsubmit:preventDefault="true">
            @* 1. Provider *@
            <fieldset>
                <legend class="mb-1.5 text-sm font-medium text-slate-700">1 · Provider</legend>
                <div class="grid gap-2 sm:grid-cols-2" role="radiogroup" data-testid="llm-provider">
                    @foreach (var (id, name, hint) in Providers)
                    {
                        var on = _provider == id;
                        <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" @onclick="() => ChooseProvider(id)" disabled="@_testing"
                                class="@Ui.Cx("rounded-md border px-3 py-2 text-left text-sm transition", on ? "border-blue-500 bg-blue-50 ring-1 ring-blue-500" : "border-slate-300 hover:border-slate-400")">
                            <span class="block font-medium text-slate-900">@name</span>
                            <span class="block text-xs text-slate-500">@hint</span>
                        </button>
                    }
                </div>
            </fieldset>

            @* 2. Key *@
            <label class="block space-y-1 text-sm font-medium text-slate-700">
                2 · @(_provider == "github" ? "GitHub token" : "Anthropic API key")
                <input type="password" @bind="_key" @bind:after="KeyChanged" maxlength="500" autocomplete="off" data-testid="llm-key"
                       placeholder="@(HasSavedKey ? $"Saved: {_status.KeyHint} (leave empty to keep it)" : _provider == "github" ? "github_pat_…" : "sk-ant-…")"
                       class="w-full rounded-md border border-slate-300 px-3 py-1.5 font-mono font-normal" />
                <span class="block text-xs font-normal text-slate-500">Encrypted on the server after a passing test. Never sent back to the browser.</span>
            </label>
            @if (_provider == "anthropic")
            {
                <details class="text-sm" open="@(!string.IsNullOrWhiteSpace(_baseUrl))">
                    <summary class="cursor-pointer text-xs text-slate-500">Use a gateway (optional)</summary>
                    <input @bind="_baseUrl" @bind:after="KeyChanged" maxlength="300" placeholder="https://api.anthropic.com" aria-label="Gateway base URL"
                           class="mt-1 w-full rounded-md border border-slate-300 px-3 py-1.5 font-mono" />
                </details>
            }

            @* 3. Model *@
            <div class="space-y-1">
                <div class="flex items-center justify-between">
                    <label for="llm-model" class="text-sm font-medium text-slate-700">3 · Model</label>
                    <button type="button" class="inline-flex items-center gap-1 text-xs text-blue-700 hover:underline disabled:opacity-50" @onclick="() => LoadModels(force: true)" disabled="@(_loadingModels || _testing)" data-testid="llm-refresh-models">
                        @if (_loadingModels)
                        {
                            <Spinner Class="h-3 w-3" /><span>Loading models…</span>
                        }
                        else
                        {
                            <span>↻ Refresh list</span>
                        }
                    </button>
                </div>
                <select id="llm-model" @bind="ModelChoice" disabled="@(_loadingModels || _testing)" data-testid="llm-model"
                        class="w-full rounded-md border border-slate-300 bg-surface px-3 py-1.5 text-sm">
                    <option value="">Provider default@(_provider == "github" ? " (Copilot picks)" : $" ({LlmKeys.DefaultClaudeModel})")</option>
                    @if (_model.Length > 0 && _model != Custom && !_models.Any(m => m.Id == _model))
                    {
                        <option value="@_model">@_model@(_models.Count > 0 ? " (not in your list)" : "")</option>
                    }
                    @foreach (var m in _models)
                    {
                        <option value="@m.Id">@m.Label@(m.Label == m.Id ? "" : $" — {m.Id}")</option>
                    }
                    <option value="@Custom">Other (type a model name)…</option>
                </select>
                @if (_customModel)
                {
                    <input @bind="_model" @bind:event="oninput" maxlength="100" aria-label="Model name" placeholder="@(_provider == "github" ? "e.g. gpt-4.1" : "e.g. claude-sonnet-4-6")"
                           class="w-full rounded-md border border-slate-300 px-3 py-1.5 font-mono text-sm" />
                }
                <p class="text-xs text-slate-500" data-testid="llm-model-note">
                    @if (_modelsError is not null)
                    {
                        <span class="text-red-700">@_modelsError</span>
                    }
                    else if (_models.Count > 0)
                    {
                        <text>@_models.Count models available to this key.</text>
                    }
                    else if (!_loadingModels)
                    {
                        <text>Enter a key to see the models it can use.</text>
                    }
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-2 border-t border-slate-100 pt-3">
                <Btn Type="submit" Variant="primary" Disabled="@_testing" data-testid="llm-test">
                    @if (_testing)
                    {
                        <Spinner Class="h-3.5 w-3.5" />
                    }
                    @(_testing ? "Testing…" : "Test connection and save")
                </Btn>
                @if (_status.Mode == "live" || _status.Source == "Settings page")
                {
                    <Btn Variant="ghost" OnClick="UseRecorded" Disabled="@_testing">Switch to recorded mode</Btn>
                }
            </div>
        </form>
        @if (_test is not null)
        {
            <div class="@Ui.Cx("mt-3 rounded-md px-3 py-2 text-sm", _test.Ok ? "bg-emerald-50 text-emerald-900" : "bg-red-50 text-red-900")" data-testid="llm-test-result">
                <strong>@(_test.Ok ? "✓ Connected." : "✗ Connection failed.")</strong> @_test.Message
                @if (_test.Ok)
                {
                    <span class="block text-xs">@Ui.Number(_test.InputTokens) in + @Ui.Number(_test.OutputTokens) out tokens@(_test.Estimated ? " (estimated)" : "") · @Ui.Number(_test.LatencyMs) ms</span>
                }
            </div>
        }
        @if (_llmError is not null)
        {
            <div class="mt-3"><ErrorBox Message="@_llmError" /></div>
        }

        <label class="mt-4 flex cursor-pointer items-start justify-between gap-4 border-t border-slate-100 pt-4">
            <span class="text-sm">
                <span class="block font-medium text-slate-700">Show model name on AI results</span>
                <span class="block text-xs text-slate-500">@(_showModel ? "AI-generated (claude-haiku-4.5) — not confirmed" : "AI-generated — not confirmed")</span>
            </span>
            <input type="checkbox" role="switch" class="peer sr-only" checked="@_showModel" @onchange="ToggleShowModel" data-testid="show-model-name" />
            <span aria-hidden="true" class="@Ui.Cx("relative mt-0.5 h-5 w-9 shrink-0 rounded-full transition peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500", _showModel ? "bg-blue-600" : "bg-slate-300")">
                <span class="@Ui.Cx("absolute top-0.5 h-4 w-4 rounded-full bg-white shadow transition-all", _showModel ? "left-[18px]" : "left-0.5")"></span>
            </span>
        </label>
        @if (_prefError is not null)
        {
            <p class="mt-2 text-xs text-red-700">@_prefError</p>
        }
    </Card>

    <Card Title="Token usage by key" Icon="metrics">
        @if (_usage.Count == 0)
        {
            <p class="text-sm text-slate-500">No live model calls yet.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm" data-testid="llm-usage">
                    <thead class="text-xs text-slate-500">
                        <tr><th class="py-1 pr-3 font-medium">Key</th><th class="pr-3 font-medium">Model</th><th class="pr-3 text-right font-medium">Calls</th><th class="pr-3 text-right font-medium">Today in / out</th><th class="pr-3 text-right font-medium">Total in / out</th><th class="font-medium">Last used</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var u in _usage)
                        {
                            <tr class="border-t border-slate-200">
                                <td class="py-1.5 pr-3"><span class="font-mono">@u.KeyHint</span> <span class="block text-xs text-slate-500">@LlmKeys.Label(u.Provider)</span></td>
                                <td class="pr-3 font-mono text-xs">@(u.Model ?? "default")</td>
                                <td class="pr-3 text-right tabular-nums">@u.Calls</td>
                                <td class="pr-3 text-right tabular-nums">@Ui.Number(u.TodayInputTokens) / @Ui.Number(u.TodayOutputTokens)</td>
                                <td class="pr-3 text-right tabular-nums">@Ui.Number(u.InputTokens) / @Ui.Number(u.OutputTokens)@(u.Estimated ? " ~" : "")</td>
                                <td class="text-xs text-slate-500">@Ui.FormatTime(u.LastUsed, true)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_usage.Any(u => u.Estimated))
            {
                <p class="mt-2 text-xs text-slate-500">~ Estimated: Copilot doesn't report token counts.</p>
            }
        }
    </Card>

    <Card Title="Data source" Icon="source">
        <dl class="grid grid-cols-[8rem_1fr] gap-y-2 text-sm">
            <dt class="text-slate-500">Data</dt>
            <dd><span class="font-medium">Demo dataset</span> <span class="text-slate-500">· no live integrations</span></dd>
            <dt class="text-slate-500">Analysis</dt>
            <dd>
                @if (_config.LlmMode == "live")
                {
                    <text>Live model · <span class="font-mono">@_config.Model</span></text>
                }
                else
                {
                    <text>Recorded <span class="text-slate-500">· no model is called</span></text>
                }
            </dd>
            <dt class="text-slate-500">Daily limit</dt>
            <dd>
                @if (_config.LiveAvailable)
                {
                    <span class="tabular-nums">@_config.LiveRunsToday / @_config.LiveDailyLimit</span> <span class="text-slate-500">model calls today (UTC)</span>
                }
                else
                {
                    <span class="text-slate-500">Live runs off (needs a live provider and LIVE_ACCESS_CODE)</span>
                }
            </dd>
        </dl>
    </Card>

    <Card Title="Access code" Icon="key">
        <p class="text-sm text-slate-600">
            Needed for live model runs and admin actions from outside localhost. Matches <span class="font-mono">LIVE_ACCESS_CODE</span>; kept only in this browser.
        </p>
        <form class="mt-3 flex flex-wrap items-center gap-2" @onsubmit="SaveCode" @onsubmit:preventDefault="true">
            <input type="password" @bind="_code" @bind:event="oninput" placeholder="Access code" aria-label="Access code" autocomplete="off"
                   class="w-64 rounded-md border border-slate-300 px-3 py-1.5 text-sm" />
            <Btn Type="submit" Disabled="@(_code.Trim() == Codes.Current)">Save</Btn>
            @if (Codes.Current.Length > 0)
            {
                <Btn Variant="ghost" OnClick="ForgetCode">Forget</Btn>
            }
            <span class="text-xs text-slate-500">@(Codes.Current.Length > 0 ? "Saved in this browser." : "No code saved.")</span>
        </form>
    </Card>

    <Card Title="Reset demo data" Icon="reset">
        <p class="text-sm text-slate-600">Deletes investigations, feedback and RCA drafts, and restores the seeded incidents.</p>
        <div class="mt-3 flex items-center gap-2">
            @if (!_confirming)
            {
                <Btn OnClick="() => _confirming = true" Disabled="@(!_config.DemoMode)">Reset demo data…</Btn>
            }
            else
            {
                <Btn Variant="danger" OnClick="Reset">Yes, reset everything</Btn>
                <Btn Variant="ghost" OnClick="() => _confirming = false">Cancel</Btn>
            }
            @if (_resetDone && !_confirming)
            {
                <span class="text-sm text-emerald-700">Demo data restored.</span>
            }
        </div>
        @if (!_config.DemoMode)
        {
            <p class="mt-2 text-xs text-slate-500">Disabled: the server is not running with DEMO_MODE=true.</p>
        }
        @if (_resetError is not null)
        {
            <div class="mt-3"><ErrorBox Message="@_resetError" /></div>
        }
    </Card>
</div>

@code {
    [CascadingParameter(Name = "IsLocal")] private bool IsLocal { get; set; }

    private AppConfig _config = new();
    private bool _confirming;
    private bool _resetDone;
    private string? _resetError;
    private string _code = "";

    private static readonly (string Id, string Name, string Hint)[] Providers =
    [
        ("github", "GitHub Copilot", "Uses a GitHub token with Copilot access"),
        ("anthropic", "Anthropic Claude", "Uses an Anthropic API key"),
    ];
    private const string Custom = "__custom";

    private LlmStatus _status = new("recorded", null, null, null, "none", null, null);
    private List<LlmUsageRow> _usage = [];
    private string _provider = "github";
    private string _model = "";
    private bool _customModel;
    private string _key = "";
    private string? _baseUrl;
    private bool _testing;
    private LlmTestResult? _test;
    private string? _llmError;
    private List<LlmModelOption> _models = [];
    private bool _loadingModels;
    private string? _modelsError;
    private int _modelsRequest;

    private bool _showModel;
    private string? _prefError;

    private void ToggleShowModel(ChangeEventArgs e)
    {
        _prefError = null;
        try
        {
            Service.SetShowModelName(e.Value is true, new Caller(Codes.Current, IsLocal));
        }
        catch (Exception err)
        {
            _prefError = Ui.Message(err);
        }
        _showModel = Service.ShowModelName;
    }

    private bool HasSavedKey => _status.Provider == _provider && _status.KeyHint is not null;

    private string ModelChoice
    {
        get => _customModel ? Custom : _model;
        set
        {
            _customModel = value == Custom;
            _model = _customModel ? "" : value;
        }
    }

    protected override void OnInitialized()
    {
        _config = Service.Config();
        _showModel = Service.ShowModelName;
        LoadLlm();
        if (_status.Provider is { } p) _provider = p;
        _model = _status.Model is { } m && m != "Copilot default" ? m : "";
    }

    private async Task ChooseProvider(string provider)
    {
        if (provider == _provider) return;
        _provider = provider;
        _model = "";
        _customModel = false;
        _key = "";
        _test = null;
        await LoadModels();
    }

    private Task KeyChanged() => LoadModels();

    /// <summary>Asks the provider which models the typed (or saved) key can use. A late answer for an older request is ignored.</summary>
    private async Task LoadModels(bool force = false)
    {
        var request = ++_modelsRequest;
        var provider = _provider;
        _loadingModels = true;
        _modelsError = null;
        if (force) _models = [];
        StateHasChanged();
        try
        {
            var models = await Service.ListLlmModels(provider, _key, _baseUrl, new Caller(Codes.Current, IsLocal));
            if (request != _modelsRequest) return;
            _models = models;
        }
        catch (Exception err)
        {
            if (request != _modelsRequest) return;
            _models = [];
            _modelsError = $"{Ui.Message(err)} You can still choose Provider default or type a name.";
        }
        finally
        {
            if (request == _modelsRequest) _loadingModels = false;
        }
    }

    private void LoadLlm()
    {
        _status = Service.GetLlmStatus();
        _usage = Service.LlmUsage();
    }

    private async Task TestAndSave()
    {
        _testing = true;
        _test = null;
        _llmError = null;
        try
        {
            _test = await Service.TestAndSaveLlm(_provider, _model, _key, _baseUrl, new Caller(Codes.Current, IsLocal));
            _key = "";
        }
        catch (Exception err)
        {
            _llmError = Ui.Message(err);
        }
        finally
        {
            _testing = false;
            AfterLlmChange();
        }
    }

    private void UseRecorded()
    {
        _test = null;
        _llmError = null;
        try
        {
            Service.UseRecordedLlm(new Caller(Codes.Current, IsLocal));
        }
        catch (Exception err)
        {
            _llmError = Ui.Message(err);
        }
        AfterLlmChange();
    }

    private void AfterLlmChange()
    {
        _config = Service.Config();
        LoadLlm();
        // Navigating to the same page re-reads the header's "LLM:" badge; this page keeps its state.
        Nav.NavigateTo(Nav.Uri, replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Codes.Load();
        _code = Codes.Current;
        StateHasChanged();
        await LoadModels();
        StateHasChanged();
    }

    private async Task SaveCode() => await Codes.Set(_code.Trim());

    private async Task ForgetCode()
    {
        await Codes.Set("");
        _code = "";
    }

    private void Reset()
    {
        _resetError = null;
        _resetDone = false;
        try
        {
            Service.DemoReset(new Caller(Codes.Current, IsLocal));
            _confirming = false;
            _resetDone = true;
            _config = Service.Config();
        }
        catch (Exception err)
        {
            _resetError = Ui.Message(err);
        }
    }
}
